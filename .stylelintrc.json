{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-order"],
  "rules": {
    "indentation": 2,
    "string-quotes": "double",
    "no-duplicate-selectors": true,
    "color-hex-case": "lower",
    "color-hex-length": "short",
    "color-named": "never",
    "color-no-invalid-hex": true,
    "font-family-name-quotes": "always-unless-keyword",
    "font-weight-notation": "numeric",
    "function-url-quotes": "always",
    "number-leading-zero": "always",
    "number-no-trailing-zeros": true,
    "length-zero-no-unit": true,
    "unit-case": "lower",
    "property-case": "lower",
    "shorthand-property-no-redundant-values": true,
    "declaration-no-important": true,
    "declaration-colon-space-after": "always",
    "declaration-colon-space-before": "never",
    "declaration-block-no-duplicate-properties": true,
    "declaration-block-trailing-semicolon": "always",
    "declaration-block-semicolon-space-before": "never",
    "declaration-block-semicolon-space-after": "always",
    "declaration-block-single-line-max-declarations": 1,
    "rule-empty-line-before": "always-multi-line",
    "block-no-empty": true,
    "selector-pseudo-element-colon-notation": "double",
    "selector-pseudo-class-no-unknown": true,
    "selector-type-case": "lower",
    "selector-type-no-unknown": true,
    "selector-max-empty-lines": 0,
    "selector-combinator-space-after": "always",
    "selector-attribute-operator-space-before": "never",
    "selector-attribute-operator-space-after": "always",
    "selector-attribute-quotes": "always",
    "selector-attribute-brackets-space-inside": "never",
    "selector-pseudo-class-parentheses-space-inside": "never",
    "selector-max-specificity": "0,3,1",
    "selector-class-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__([a-z0-9]+(-[a-z0-9]+)*)|(--([a-z0-9]+(-[a-z0-9]+)*)))?$",
    "selector-id-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "selector-max-id": 0,
    "selector-max-universal": 0,
    "selector-max-type": 0,
    "selector-max-combinators": 3,
    "selector-max-attribute": 3,
    "selector-max-pseudo-class": 3,
    "selector-max-pseudo-element": 2,
    "selector-no-vendor-prefix": true,
    "property-no-vendor-prefix": true,
    "at-rule-no-vendor-prefix": true,
    "at-rule-name-case": "lower",
    "at-rule-name-newline-after": "always-multi-line",
    "at-rule-name-space-after": "always-single-line",
    "at-rule-no-unknown": [true, {
      "ignoreAtRules": ["tailwind", "apply", "layer", "responsive", "screen", "variants", "base", "components", "utilities"]
    }],
    "at-rule-empty-line-before": ["always", {"except": ["first-nested"]}],
    "media-feature-name-case": "lower",
    "media-feature-name-no-vendor-prefix": true,
    "media-feature-parentheses-space-inside": "never",
    "media-feature-range-operator-space-before": "never",
    "media-feature-range-operator-space-after": "always",
    "custom-property-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "color-function-notation": "modern",
    "alpha-value-notation": "number",
    "hue-degree-notation": "number",
    "function-allowed-list": ["clamp", "min", "max", "calc"],
    "function-calc-no-unspared-operator": true,
    "function-case": "lower",
    "function-comma-space-after": "always-single-line",
    "function-comma-space-before": "never",
    "function-no-unknown": true,
    "function-parentheses-space-inside": "never",
    "function-whitespace-after": "always",
    "number-max-precision": 3,
    "property-no-unknown": true,
    "no-descending-specificity": true,
    "no-duplicate-at-import-rules": true,
    "no-empty-first-line": true,
    "no-empty-source": true,
    "no-invalid-hex": true,
    "no-irregular-whitespace": true,
    "no-missing-end-of-source-newline": true,
    "time-min-milliseconds": 100,
    "value-keyword-case": "lower",
    "value-no-vendor-prefix": true,
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "align-items",
      "align-self",
      "justify-content",
      "justify-items",
      "justify-self",
      "flex-wrap",
      "flex-direction",
      "flex-grow",
      "flex-shrink",
      "flex-basis",
      "grid-template-columns",
      "grid-template-rows",
      "grid-template-areas",
      "grid-column",
      "grid-row",
      "grid-area",
      "grid-auto-flow",
      "grid-auto-columns",
      "grid-auto-rows",
      "gap",
      "column-gap",
      "row-gap",
      "width",
      "min-width",
      "max-width",
      "height",
      "min-height",
      "max-height",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "border",
      "border-width",
      "border-style",
      "border-color",
      "border-top",
      "border-right",
      "border-bottom",
      "border-left",
      "border-radius",
      "background",
      "background-color",
      "background-image",
      "background-size",
      "background-position",
      "background-repeat",
      "color",
      "font",
      "font-family",
      "font-size",
      "font-weight",
      "font-style",
      "font-variant",
      "line-height",
      "letter-spacing",
      "text-align",
      "text-decoration",
      "text-transform",
      "text-indent",
      "text-shadow",
      "opacity",
      "visibility",
      "transform",
      "transition",
      "animation",
      "box-shadow",
      "outline",
      "cursor",
      "overflow",
      "transform-origin",
      "transform-style",
      "perspective",
      "backface-visibility"
    ]
  },
  "overrides": [
    {
      "files": ["**/*.scss"],
      "rules": {
        "indentation": 2
      }
    },
    {
      "files": ["**/*.css"],
      "rules": {
        "indentation": 2
      }
    }
  ]
}