{
  "name": "tradelia-core",
  "version": "1.0.0",
  "private": true,
  "description": "Decision-compatibility homepage for financial tooling.",
  "scripts": {
    "dev": "next dev",
    "dev:local": "concurrently \"npm run ws:daemon\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "ws:daemon": "node --import tsx services/ws-daemon.ts",
    "regime:run": "node --import tsx cli/regime-run.ts --symbol BTCUSDT --limit 300",
    "regime:scan": "node --import tsx cli/regime-scan.ts --symbols-file config/symbols.json --limit 300 --concurrency 3",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/regime4h.test.ts tests/universe-score.test.ts",
    "validate": "npm run type-check && npm run lint",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "next": "^16.0.10",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.10",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
