{
  "name": "tradelia-2026",
  "version": "2026.02",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "inflight": "npm:@isaacs/inflight@^1.0.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --run --reporter=verbose",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "test:a11y": "vitest --run --config vitest.a11y.config.ts",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:marketing": "cross-env ANALYZE=true npm run build",
    "analyze:dashboard": "cross-env ANALYZE=true npm run build",
    "build:check-budgets": "npm run build && node scripts/check-bundle-budgets.js",
    "check:versions": "node scripts/check-versions.js",
    "check:deps": "npx madge --circular --extensions ts,tsx src/",
    "check:boundaries": "eslint . --ext .ts,.tsx --no-fix",
    "lighthouse": "lhci autorun",
    "bundle:analyze": "npx @next/bundle-analyzer .next"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.62.7",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "next": "^15.1.3",
    "next-intl": "^4.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.4",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@eslint/eslintrc": "^3.2.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.1.3",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.5.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "renovate": {
    "extends": [
      "config:base"
    ],
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true,
    "automergeType": "pr",
    "major": {
      "automerge": false,
      "reviewersFromCodeOwners": true
    }
  }
}
